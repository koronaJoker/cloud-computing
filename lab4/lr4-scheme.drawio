          <mxGeometry x="360" y="230" width="240" height="210" as="geometry" />
        </mxCell>
        <mxCell id="pubB" value="public-b 10.X.1.0/24" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;dashed=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="230" width="240" height="210" as="geometry" />
        </mxCell>
        <mxCell id="privA" value="private-a 10.X.10.0/24" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="470" width="240" height="160" as="geometry" />
        </mxCell>

        <!-- Security groups -->
        <mxCell id="webSg" value="web-sg" style="rounded=0;strokeColor=#DD344C;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;fontColor=#DD344C;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="385" y="270" width="190" height="150" as="geometry" />
