        <!-- S3 (вне VPC, внутри региона) -->
        <mxCell id="s3" value="Amazon S3&#xa;timecapsule-dev-uploads-&lt;nickname&gt;&#xa;префикс uploads/&#xa;версионирование&#xa;политика бакета: только HTTPS" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#60A337;gradientDirection=north;fillColor=#277116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontSize=10;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
