        <!-- Ваш компьютер -> S3 (консоль и CLI) -->
        <mxCell id="e_cli" value="консоль и AWS CLI, HTTPS (Часть 1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="me" target="s3">
          <mxGeometry relative="1" as="geometry">
