        <!-- Легенда и подпись -->
        <mxCell id="legend" value="- - -  пунктир: административный доступ и связь роли с экземпляром" style="text;html=0;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1">
