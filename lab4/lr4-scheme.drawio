        <mxCell id="bastionSg" value="bastion-sg" style="rounded=0;strokeColor=#DD344C;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;fontColor=#DD344C;fontSize=11;" vertex="1" parent="1">
