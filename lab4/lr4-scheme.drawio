        <!-- IGW -> app-server -->
        <mxCell id="e_igw_app" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="igw" target="app">
          <mxGeometry relative="1" as="geometry" />
