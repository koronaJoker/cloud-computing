        <mxCell id="dbSg" value="db-sg" style="rounded=0;strokeColor=#DD344C;fillColor=none;verticalAlign=top;align=left;spacingLeft=6;fontColor=#DD344C;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="385" y="500" width="190" height="110" as="geometry" />
