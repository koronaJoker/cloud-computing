        <mxCell id="e_ssh" value="SSH 22 только с вашего IP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;dashed=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="igw" target="bastion">
