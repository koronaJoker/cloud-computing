        <mxCell id="me" value="Ваш компьютер" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontSize=11;shape=mxgraph.aws4.user;" vertex="1" parent="1">
          <mxGeometry x="30" y="560" width="50" height="50" as="geometry" />
        </mxCell>

        <!-- ===== Стрелки ===== -->

        <!-- Скачивание вложений браузером по подписанному URL -->
        <mxCell id="e_signed" value="GET по подписанному URL, HTTPS (Часть 2)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1F5FBF;fontColor=#1F5FBF;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="users" target="s3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="55" y="150" />
              <mxPoint x="1050" y="150" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Запросы приложения к S3: PutObject, DeleteObject -->
        <mxCell id="e_put" value="PutObject, DeleteObject, HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#277116;fontColor=#277116;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="app" target="s3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="615" y="315" />
              <mxPoint x="615" y="455" />
              <mxPoint x="910" y="455" />
              <mxPoint x="910" y="220" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Профиль экземпляра: IAM-роль -> app-server -->
